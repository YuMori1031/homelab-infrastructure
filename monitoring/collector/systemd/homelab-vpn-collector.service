[Unit]
Description=Read-only HomeLab VPN SA collector
After=strongswan.service
[Service]
Type=oneshot
User=root
Group=zabbix
ExecStart=/usr/bin/python3 -B /usr/local/libexec/homelab-vpn-collector.py
StateDirectory=homelab-vpn-monitor
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/homelab-vpn-monitor
ReadWritePaths=/var/log/homelab-vpn-monitor
CapabilityBoundingSet=CAP_DAC_OVERRIDE
