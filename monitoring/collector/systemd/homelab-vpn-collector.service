[Unit]
Description=Read-only HomeLab VPN SA collector
After=strongswan.service
[Service]
Type=oneshot
User=root
Group=zabbix
ExecStart=/opt/homelab/example -B /opt/homelab/example
StateDirectory=homelab-vpn-monitor
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt/homelab/example
ReadWritePaths=/opt/homelab/example
CapabilityBoundingSet=CAP_DAC_OVERRIDE
